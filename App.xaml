<Application x:Class="AshkanIndustrialOperations.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="Views/LoginWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#07111F"/><SolidColorBrush x:Key="Panel" Color="#0D1B2D"/><SolidColorBrush x:Key="Card" Color="#12243A"/><SolidColorBrush x:Key="CardHover" Color="#17304D"/><SolidColorBrush x:Key="Accent" Color="#22D3EE"/><SolidColorBrush x:Key="Accent2" Color="#34D399"/><SolidColorBrush x:Key="Text" Color="#F8FAFC"/><SolidColorBrush x:Key="Muted" Color="#9FB0C5"/><SolidColorBrush x:Key="Danger" Color="#FB7185"/><SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="5"/></Style>
    <Style x:Key="MetricStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C9D7E8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#17304D"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#04131B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#0B1727"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#29415D"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D1B2D"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#0D1B2D"/><Setter Property="AlternatingRowBackground" Value="#11243A"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="40"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#172A42"/><Setter Property="Foreground" Value="#BFD0E3"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Application.Resources>
</Application>
