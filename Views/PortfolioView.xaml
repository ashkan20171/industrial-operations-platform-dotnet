<UserControl x:Class="AshkanIndustrialOperations.Views.PortfolioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Engineering Overview" Style="{StaticResource PageTitle}"/><TextBlock Text="A recruiter-friendly map of the platform architecture and engineering decisions" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
<UniformGrid Columns="3"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DOMAIN" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="Assets • Alarms • Work Orders • Maintenance • Inventory • Telemetry" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ARCHITECTURE" Foreground="{StaticResource Accent2}" FontWeight="Bold"/><TextBlock Text="WPF/.NET 8 • incremental MVVM • service boundaries • repository abstraction • RBAC" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="INDUSTRIAL EDGE" Foreground="#FBBF24" FontWeight="Bold"/><TextBlock Text="Adapter-ready OPC UA / MQTT / REST integration with explicit demo boundaries" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Engineering principles" Style="{StaticResource SectionTitle}"/><TextBlock Text="• Explainable operational risk instead of fake AI claims&#x0a;• Least-privilege role-based navigation&#x0a;• Atomic, versioned local persistence&#x0a;• UI-independent persistence contracts&#x0a;• Auditability and explicit operational states&#x0a;• Incremental refactoring to reduce regression risk" Foreground="{StaticResource Text}" LineHeight="27" Margin="0,14,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Production evolution" Style="{StaticResource SectionTitle}"/><TextBlock Text="1. Replace JSON repository with EF Core / SQL Server&#x0a;2. Connect certified OPC UA and MQTT clients&#x0a;3. Add integration and ViewModel unit tests&#x0a;4. Add OpenTelemetry / structured logging&#x0a;5. Introduce deployment pipeline and signed releases&#x0a;6. Train ML.NET models only when real labelled data exists" Foreground="{StaticResource Text}" LineHeight="27" Margin="0,14,0,0"/></StackPanel></Border></Grid>
<Border Style="{StaticResource CardStyle}" Margin="5,16,5,5"><StackPanel><TextBlock Text="Portfolio statement" Style="{StaticResource SectionTitle}"/><TextBlock Text="This repository demonstrates how desktop engineering, industrial operations concepts, security boundaries, persistence and human-centred UX can be combined in a maintainable .NET application. Demo data is intentionally identified as demo data; integration adapters are designed for extension rather than presented as live PLC connections." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,12,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></UserControl>
