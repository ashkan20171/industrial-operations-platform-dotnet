<UserControl x:Class="AshkanIndustrialOperations.Views.ConnectivityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Style="{StaticResource PageTitle}" Text="Industrial Connectivity"/><TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,18" Text="Edge-ready integration surface for OPC UA, MQTT and historian/API adapters. Endpoints are configuration examples; no external connection is opened in demo mode."/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Connection registry"/><DataGrid x:Name="ConnectionsGrid" Margin="0,14,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100"/><DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="2*"/><DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="1.5*"/><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
<StackPanel Grid.Column="1"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Secure-by-design"/><TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" Text="Production adapters should validate certificates, isolate secrets from source control, enforce least privilege and reconnect with bounded backoff."/><TextBlock Foreground="#86EFAC" FontWeight="Bold" Margin="0,16,0,0" Text="✓ No hard-coded production credentials"/><TextBlock Foreground="#86EFAC" FontWeight="Bold" Margin="0,8,0,0" Text="✓ Adapter boundary keeps UI protocol-agnostic"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Data pipeline"/><TextBlock x:Name="ArchitectureText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer></UserControl>
