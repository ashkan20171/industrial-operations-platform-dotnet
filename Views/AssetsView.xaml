<UserControl x:Class="AshkanIndustrialOperations.Views.AssetsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Asset Management" Style="{StaticResource PageTitle}"/><TextBlock Text="Machine registry, condition and service visibility" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="AssetName" Width="150" Text="NEW-ASSET"/><TextBox x:Name="AreaName" Width="130" Text="Assembly"/><Button Content="+ Add asset" Click="Add_Click"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0"><DataGrid ItemsSource="{Binding Machines}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ASSET" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}"/><DataGridTextColumn Header="OEE" Binding="{Binding Oee,StringFormat={}{0:F1}%}"/><DataGridTextColumn Header="TEMPERATURE" Binding="{Binding Temperature,StringFormat={}{0:F0} °C}"/><DataGridTextColumn Header="VIBRATION" Binding="{Binding Vibration,StringFormat={}{0:F1} mm/s}"/><DataGridTextColumn Header="LAST SERVICE" Binding="{Binding LastService}"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>