<Window x:Class="AshkanIndustrialOperations.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ashkan Industrial Operations" Width="1160" Height="720" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Margin="28" CornerRadius="26" Background="#0D2338"><Grid><Ellipse Width="430" Height="430" Fill="#102F47" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0"/><Ellipse Width="280" Height="280" Fill="#0D3A3C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-100"/><StackPanel VerticalAlignment="Center" Margin="58"><Border Background="#12334B" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left"><TextBlock Text="AIOP • INDUSTRIAL INTELLIGENCE" Foreground="#67E8F9" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="Operate smarter.&#10;Maintain earlier." FontSize="46" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,22,0,14"/><TextBlock Text="A modern desktop command center for asset health, alarms, maintenance, inventory, telemetry and reliability analytics." FontSize="16" LineHeight="25" Foreground="#B6C7D9" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Left"/><UniformGrid Columns="3" Margin="0,38,0,0"><StackPanel><TextBlock Text="99.97%" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Plant availability" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel><TextBlock Text="24/7" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Telemetry ready" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel><TextBlock Text="RBAC" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Secure access" Foreground="{StaticResource Muted}"/></StackPanel></UniformGrid></StackPanel></Grid></Border><StackPanel Grid.Column="1" Width="360" VerticalAlignment="Center"><TextBlock Text="Welcome back" Foreground="{StaticResource Text}" FontSize="32" FontWeight="Bold"/><TextBlock Text="Sign in to the industrial operations workspace" Foreground="{StaticResource Muted}" Margin="0,8,0,28"/><TextBlock Text="USERNAME" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="Username" Text="admin" Height="44"/><TextBlock Text="PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,0"/><PasswordBox x:Name="Password" Password="1234" Padding="12" Margin="4,6,4,20" Height="44" Background="#0B1727" Foreground="White" BorderBrush="#29415D" KeyDown="Password_KeyDown"/><Button Content="SIGN IN TO COMMAND CENTER" Height="48" Click="SignIn_Click"/><Border Background="#10263A" CornerRadius="10" Padding="12" Margin="4,16"><TextBlock Text="Demo credentials: admin / 1234" Foreground="#A5F3FC" TextAlignment="Center"/></Border><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="4,4" TextWrapping="Wrap"/></StackPanel></Grid></Window>
