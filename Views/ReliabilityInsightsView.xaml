<UserControl x:Class="AshkanIndustrialOperations.Views.ReliabilityInsightsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="Reliability Insights" Style="{StaticResource PageTitle}"/><TextBlock Text="Explainable condition scoring for maintenance prioritization • deterministic demo analytics, no cloud dependency" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/><UniformGrid Columns="3"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="HIGH-RISK ASSETS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RiskCount" Style="{StaticResource MetricStyle}"/><TextBlock Text="Condition score ≥ 60" Foreground="#FDA4AF"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="LOW-STOCK PARTS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LowStockCount" Style="{StaticResource MetricStyle}"/><TextBlock Text="Potential maintenance constraint" Foreground="#FDE68A"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="PM DUE ≤ 7 DAYS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DueCount" Style="{StaticResource MetricStyle}"/><TextBlock Text="Upcoming planned interventions" Foreground="#93C5FD"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource CardStyle}" Margin="5,16,5,5"><StackPanel><TextBlock Text="Explainable Asset Risk Ranking" Style="{StaticResource SectionTitle}"/><TextBlock Text="Score combines temperature, vibration, OEE degradation and current operational state." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><DataGrid x:Name="RiskGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ASSET" Binding="{Binding Asset}" Width="*"/><DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="*"/><DataGridTextColumn Header="RISK SCORE" Binding="{Binding Score,StringFormat={}{0:F0}/100}"/><DataGridTextColumn Header="LEVEL" Binding="{Binding Level}"/><DataGridTextColumn Header="DRIVER" Binding="{Binding Driver}" Width="2*"/><DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="5,10,5,5"><StackPanel><TextBlock Text="Engineering Note" Style="{StaticResource SectionTitle}"/><TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Text="This module intentionally uses transparent rule-based scoring rather than claiming machine-learning predictions without training data. It is designed as a clean extension point for future ML.NET, OPC UA, MQTT or historian integrations."/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
