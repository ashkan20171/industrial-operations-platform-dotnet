<UserControl x:Class="AshkanIndustrialOperations.Views.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Users &amp; Role Access" Style="{StaticResource PageTitle}"/><Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Role-based access control" Style="{StaticResource SectionTitle}"/><TextBlock Text="Administrator • Supervisor • Maintenance Engineer • Operator • Viewer" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Add demo user" Click="Add_Click"/></Grid></Border><DataGrid Grid.Row="2" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="190"/><DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Last login" Binding="{Binding LastLogin}" Width="150"/></DataGrid.Columns></DataGrid></Grid></UserControl>
