<UserControl x:Class="AshkanIndustrialOperations.Views.MaintenanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Maintenance &amp; Work Orders" Style="{StaticResource PageTitle}"/><TextBlock Text="Preventive and corrective maintenance execution" Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,12"><DataGrid x:Name="Grid" ItemsSource="{Binding WorkOrders}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="WORK ORDER" Binding="{Binding Number}"/><DataGridTextColumn Header="ASSET" Binding="{Binding Asset}"/><DataGridTextColumn Header="TYPE" Binding="{Binding Type}"/><DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}"/><DataGridTextColumn Header="ASSIGNEE" Binding="{Binding Assignee}" Width="*"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate}"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></Border><Button Grid.Row="2" Content="✓ Complete selected work order" HorizontalAlignment="Right" Click="Complete_Click"/></Grid></UserControl>