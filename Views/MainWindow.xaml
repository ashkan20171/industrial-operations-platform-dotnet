<Window x:Class="AshkanIndustrialOperations.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AIOP • Industrial Operations Platform" Width="1480" Height="900" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" BorderBrush="#18304B" BorderThickness="0,0,1,0"><DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="20,22,20,12"><TextBlock Text="AIOP" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="INDUSTRIAL OPERATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><Border Background="#10362F" CornerRadius="10" Padding="10" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0"/><TextBlock Text="PLANT ONLINE • 99.97%" Foreground="#86EFAC" FontSize="11" FontWeight="Bold"/></StackPanel></Border></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0"><StackPanel><Button Style="{StaticResource NavButton}" Content="⌂   Command Center" Tag="dashboard" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="▣   Asset Management" Tag="assets" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚠   Alarm Center" Tag="alarms" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚙   Maintenance" Tag="maintenance" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⌁   Live Telemetry" Tag="telemetry" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="▤   Inventory" Tag="inventory" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="◇   Alarm Rules" Tag="rules" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="◷   Scheduler" Tag="scheduler" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="✦   Reliability Insights" Tag="insights" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="♥   Operational Health" Tag="health" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⌘   Industrial Connectivity" Tag="connectivity" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="♙   Users &amp; Roles" Tag="users" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="☷   Audit Trail" Tag="audit" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="◆   Engineering Overview" Tag="portfolio" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="settings" Click="Nav_Click"/></StackPanel></ScrollViewer>
<StackPanel DockPanel.Dock="Bottom" Margin="20"><Separator Margin="0,8" Background="#29415D"/><TextBlock x:Name="UserText" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><TextBlock x:Name="RoleText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"/><Button Content="Sign out" Background="#1B3048" Foreground="White" Click="SignOut_Click"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Background="#0A1626" BorderBrush="#1B324C" BorderThickness="0,0,0,1"><Grid Margin="26,0"><TextBlock x:Name="PageTitle" Text="Command Center" Foreground="{StaticResource Text}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBox x:Name="GlobalSearch" Width="230" ToolTip="Search assets, alarms and work orders" KeyDown="GlobalSearch_KeyDown"/><TextBlock Text="● LIVE" Foreground="#6EE7B7" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel></Grid></Border>
<ContentControl x:Name="MainContent" Grid.Row="1"/><Grid Grid.Row="2" Margin="26,0"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="DEMO / EDGE-READY • .NET 8 WPF" Foreground="#57708D" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></Grid></Grid></Grid></Window>
