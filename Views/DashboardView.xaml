<UserControl x:Class="AshkanIndustrialOperations.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><Grid><StackPanel><TextBlock Text="Operations Command Center" Style="{StaticResource PageTitle}"/><TextBlock Text="Plant-wide performance, risk and maintenance intelligence" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10362F" CornerRadius="12" Padding="12,7"><TextBlock Text="●  HEALTHY OPERATIONS" Foreground="#86EFAC" FontWeight="SemiBold"/></Border></Grid><UniformGrid Columns="4"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="OEE" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Oee}" Style="{StaticResource MetricStyle}"/><TextBlock Text="Availability × Performance × Quality" Foreground="#6EE7B7" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ASSET HEALTH" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Health}" Style="{StaticResource MetricStyle}"/><TextBlock Text="{Binding Attention}" Foreground="#FCD34D"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ACTIVE ALARMS" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Alarms}" Style="{StaticResource MetricStyle}"/><TextBlock Text="{Binding Critical}" Foreground="#FDA4AF"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="MAINTENANCE" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Maintenance}" Style="{StaticResource MetricStyle}"/><TextBlock Text="Open work orders" Foreground="#93C5FD"/></StackPanel></Border></UniformGrid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Asset Health Matrix" Style="{StaticResource SectionTitle}"/><TextBlock Text="Live condition indicators for production-critical equipment" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><DataGrid ItemsSource="{Binding Machines}" AutoGenerateColumns="False" IsReadOnly="True" Height="315"><DataGrid.Columns><DataGridTextColumn Header="ASSET" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}"/><DataGridTextColumn Header="OEE" Binding="{Binding Oee,StringFormat={}{0:F1}%}"/><DataGridTextColumn Header="TEMP" Binding="{Binding Temperature,StringFormat={}{0:F0} °C}"/><DataGridTextColumn Header="VIBRATION" Binding="{Binding Vibration,StringFormat={}{0:F1}}"/></DataGrid.Columns></DataGrid></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Reliability Risk" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Risk}" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold" Margin="0,10,0,2"/><TextBlock Text="{Binding RiskLabel}" Foreground="{StaticResource Muted}"/><TextBlock Text="CNC-04 • vibration anomaly" Foreground="#FDA4AF" FontWeight="Bold" Margin="0,18,0,5"/><ProgressBar Value="88" Height="8"/><TextBlock Text="COMP-02 • thermal drift" Foreground="#FDE68A" FontWeight="Bold" Margin="0,18,0,5"/><ProgressBar Value="67" Height="8"/><TextBlock Text="PM compliance" Foreground="{StaticResource Text}" Margin="0,18,0,5"/><ProgressBar Value="76" Height="8"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="5,10,5,5"><StackPanel><TextBlock Text="Next Maintenance Window" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding NextMaintenance}" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Risk-based prioritization enabled" Foreground="{StaticResource Accent2}"/></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer></UserControl>
