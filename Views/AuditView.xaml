<UserControl x:Class="AshkanIndustrialOperations.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Audit Trail" Style="{StaticResource PageTitle}"/><TextBlock Text="Traceable operational actions for governance and troubleshooting" Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0"><DataGrid ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding Time}"/><DataGridTextColumn Header="USER" Binding="{Binding User}"/><DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="*"/><DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>