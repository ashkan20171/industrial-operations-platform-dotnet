<UserControl x:Class="AshkanIndustrialOperations.Views.MaintenanceSchedulerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Maintenance Scheduler" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Upcoming preventive maintenance and ownership." Opacity=".65" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Background="#121C2B" CornerRadius="16" Padding="12"><DataGrid x:Name="GridData" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#EAF2FF" RowBackground="#121C2B" AlternatingRowBackground="#172438" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="*"/><DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*"/><DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="*"/><DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>